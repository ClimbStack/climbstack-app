{
  "expo": {
    "name": "ClimbStack",
    "slug": "levelup",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.gizano.levelup",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#071A2F",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "This app needs calendar access to sync your productivity blocks.",
          "calendarWritePermission": "This app needs write access to automatically save blocks to your Google Calendar."
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63ecf766-7325-45cf-8fbd-861a0dd5fca7"
      }
    }
  }
}
